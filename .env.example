# Base URL of the Titan 3000 Web API (no trailing slash)
TITAN_BASE_URL=http://titanapi-dev.nwpipe.com

# Credentials issued for this integration (sent as X-App-Id / X-Api-Key headers).
# Fill these in yourself — never commit real values.
TITAN_APP_ID=
TITAN_API_KEY=

# Port for the Streamable HTTP MCP endpoint (default 8585)
TITAN_MCP_PORT=8585

# Optional: comma-separated plant IDs excluded from the summarize_* aggregate
# and booked-order tools (e.g. inactive plants). Leave empty to include all plants.
TITAN_EXCLUDED_PLANTS=

# Booked-date index. The Titan API cannot filter on bookedDate and does not even
# return it from the sales-order LIST endpoint, so this server reads every order
# once in the background to answer "what was booked between X and Y".
# Set to false to disable (booked-date answers then become partial scans).
TITAN_ORDER_INDEX=true
# Parallel per-order fetches while indexing.
TITAN_ORDER_INDEX_CONCURRENCY=12
# Incremental refresh interval (new/changed orders only).
TITAN_ORDER_INDEX_REFRESH_MINUTES=15
# Full rebuild interval.
TITAN_ORDER_INDEX_REBUILD_HOURS=24
# Optional: persist the index here so a restart doesn't re-scan every order.
# Point it at a mounted volume when running in Docker, e.g. /data/order-index.json
TITAN_ORDER_INDEX_PATH=
# Optional: skip orders ENTERED before this date (YYYY-MM-DD) to shrink the
# initial build. Booked-date answers then say so instead of claiming complete
# coverage. Leave empty to index all ~58k orders.
TITAN_ORDER_INDEX_MIN_ORDER_DATE=
